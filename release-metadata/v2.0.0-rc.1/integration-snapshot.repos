# OpenAMRobot v2.0.0-rc.1: Baseline 1 INTEGRATION SNAPSHOT, read 2026-11-20.
# NOT release content. These branches are integration branches that are never
# merged (platform-sw PR #161, upperbody-sw PR #77, both "do not merge").
# Recorded so the simulation evidence in RELEASE_NOTES.md can be traced to the
# commits it ran on. A snapshot is development evidence, not a reviewed pin.
# Every other repository: use manifests/v2.0.0-rc.1.repos at the repository root.
repositories:
  src/openamr-platform-sw:
    type: git
    url: https://github.com/openAMRobot/openamr-platform-sw.git
    # integration/baseline1, PR #161 (draft, do not merge)
    version: fb25be1b56652316f47b7505cef021576822c558
  src/openamr-upperbody-sw:
    type: git
    url: https://github.com/openAMRobot/openamr-upperbody-sw.git
    # integration/baseline1, PR #77 (draft, do not merge); head commits since 323a2ce are [skip ci]
    version: c0af97391fd90c955053ac4d063d4f3bb3d8bae8
  src/openamrobot-interfaces:
    type: git
    url: https://github.com/openAMRobot/openamrobot-interfaces.git
    # main, the interfaces commit used by the 19 Nov two-leg run
    version: 50ed777be7990edbd3465f33fd97a158e7e3b88b
